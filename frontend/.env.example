# Copy this file to ".env.local" (git-ignored) and adjust if the backend
# is not running on this machine's localhost.

# Base URL of the FastAPI backend
VITE_API_BASE=http://localhost:8000

# Base URL of the progress WebSocket. Defaults to VITE_API_BASE with
# http -> ws / https -> wss when left unset.
# VITE_WS_BASE=ws://localhost:8000
