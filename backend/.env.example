# Copy to ".env" and adjust before deploying.
# The backend reads this at startup; it is git-ignored.

# Comma-separated browser origins allowed to call the API.
# Leave as "*" only for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uvicorn bind address used by start_backend.bat / __main__.
HOST=0.0.0.0
PORT=8000
